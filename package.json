{
  "name": "eg-launcher",
  "version": "2.7.3",
  "description": "EG Launcher — Minecraft: Java Edition launcher with instances, Microsoft login, and community content for your game.",
  "main": "dist-electron/main.js",
  "author": "EG Launcher",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/YourLovelyFox/eg-launcher.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-with-env.mjs EG_ENABLE_ADMIN=0 -- npm run build:app",
    "build:admin": "node scripts/run-with-env.mjs EG_ENABLE_ADMIN=1 -- npm run build:app",
    "build:app": "tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dist": "npm run build && node scripts/run-with-env.mjs CSC_IDENTITY_AUTO_DISCOVERY=false -- npx electron-builder --win nsis --x64 --publish never && node scripts/build-win-uninstaller.mjs",
    "dist:admin": "npm run build:admin && node scripts/run-with-env.mjs CSC_IDENTITY_AUTO_DISCOVERY=false -- npx electron-builder --win nsis --x64 --publish never && node scripts/build-win-uninstaller.mjs",
    "dist:dir": "npm run build && node scripts/run-with-env.mjs CSC_IDENTITY_AUTO_DISCOVERY=false -- npx electron-builder --win --dir --x64 --publish never",
    "dist:linux": "npm run build && npx electron-builder --linux AppImage --x64 --publish never",
    "dist:all": "npm run dist && npm run dist:linux",
    "release:check": "node scripts/check-release-assets.mjs",
    "release:notes": "node scripts/extract-changelog.mjs",
    "dist:github": "npm run dist",
    "dist:uninstaller": "node scripts/build-win-uninstaller.mjs",
    "dist:store": "node scripts/run-with-env.mjs EG_MS_STORE=1 EG_ENABLE_ADMIN=0 -- npm run build:app && node scripts/run-with-env.mjs EG_MS_STORE=1 CSC_IDENTITY_AUTO_DISCOVERY=false -- npx electron-builder --win appx --x64 --publish never"
  },
  "build": {
    "appId": "com.eg.launcher",
    "productName": "EG Launcher",
    "copyright": "Copyright © EpicTeam Studios GmbH",
    "executableName": "EG Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/eg-gate",
        "to": "eg-gate",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "news/feed.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "forceCodeSigning": false,
    "publish": {
      "provider": "github",
      "owner": "YourLovelyFox",
      "repo": "eg-launcher",
      "releaseType": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signDlls": false,
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "EG Launcher",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EG-Launcher-${version}-win-${arch}-setup.${ext}"
    },
    "appx": {
      "identityName": "44561EpicTeamStudiosGmBH.EGLauncher",
      "publisher": "CN=E5F84211-3109-40DD-A4E4-E8E7769D8658",
      "publisherDisplayName": "EpicTeam Studios",
      "applicationId": "EGLauncher",
      "displayName": "EG Launcher",
      "backgroundColor": "#0b0e14",
      "showNameOnTiles": true,
      "setBuildNumber": true,
      "languages": [
        "en-US"
      ],
      "artifactName": "EG-Launcher-${version}-win-${arch}-store.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EG Launcher",
      "uninstallDisplayName": "EG Launcher",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "unicode": true,
      "installerLanguages": [
        "en_US"
      ],
      "displayLanguageSelector": false,
      "packElevateHelper": false,
      "artifactName": "EG-Launcher-${version}-win-x64-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "EG-Launcher-${version}-linux-${arch}.${ext}",
      "synopsis": "EG Launcher — Minecraft: Java Edition companion",
      "description": "EG Launcher — manage Minecraft: Java Edition instances, Microsoft login, and community content."
    },
    "asar": true
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
